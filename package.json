{
  "name": "learn-software-design",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "og": "tsx scripts/og-images.ts",
    "check": "tsx scripts/check-prerender.ts",
    "build": "npm run og && react-router build && node -e \"require('fs').copyFileSync('build/client/__spa-fallback.html','build/client/404.html')\" && npm run check",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@react-router/node": "^7.18.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "isbot": "^5",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "shiki": "^4.6.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.5",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.8.2",
    "satori": "^0.63.2",
    "serve": "^14.2.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
